# -*- mode: caddyfile; -*-
{
	http_port 8080
	https_port 8443

	local_certs
	skip_install_trust

	pki {
		ca local {
			root {
				cert /ca.crt
				key /ca.key
			}
		}
	}
}

(mympd) {
	reverse_proxy mympd:8080 {
		transport http {
			dial_timeout 10s
		}
	}
}

music.laniakea {
	import mympd
}

qbit.laniakea {
	reverse_proxy qbittorrent:8080
}
