{
	admin off

	tailscale {
		control_url https://headscale.eleonora.gay
		ephemeral true
	}

	pki {
		ca local {
			root {
				cert /ca.crt
				key /ca.key
			}
		}
	}

	local_certs
	skip_install_trust
}

(bind) {
	bind tailscale/bunny
}

(connect) {
	reverse_proxy localhost:12345 {
		header_up +to {args[0]}
	}
}

img.bunny {
	import bind
	reverse_proxy immich:8080
}

pin.bunny {
	import bind
	reverse_proxy pinlist:8080
}

ssh.bunny {
	import bind
	import connect host.containers.internal:18213
}

sync.bunny {
	import bind
	reverse_proxy syncthing:8080
}

vencloud.bunny {
	import bind
	header ?Access-Control-Allow-Origin *
	reverse_proxy vencloud:8080
}
