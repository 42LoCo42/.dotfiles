{
	http_port 8080
	https_port 8443

	local_certs
	skip_install_trust

	pki {
		ca local {
			root {
				cert /ca.crt
				key /ca.key
			}
		}
	}
}

##### mympd #####

(mympd) {
	# connect to socket activation proxy on host
	reverse_proxy unix//caddy/mympd.sock
}

# reachable from LAN
laniakea.fritz.box {
	import mympd
}

# reachable from VPN
music.laniakea {
	import mympd
}

##### ncps #####

# reachable from LAN
laniakea.fritz.box:8501 {
	reverse_proxy ncps:8501
}

##### paperless #####

# reachable from VPN
doc.laniakea {
	reverse_proxy paperless:8080
}

##### qbittorrent #####

# reachable from VPN
qbit.laniakea {
	# connect to socket activation proxy on host
	reverse_proxy unix//caddy/qbittorrent.sock
}

##### syncthing #####

# reachable from VPN
sync.laniakea {
	reverse_proxy host.containers.internal:8384
}
