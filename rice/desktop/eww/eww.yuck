;; -*- mode: scheme; -*-

(defpoll info :interval "1s" `mpd-info info`)
(defpoll time :interval "1s" `mpd-info time-text`)
(defpoll perc :interval "1s" `mpd-info time-perc`)

(defwindow mpd-info
  :monitor 0
  :geometry (geometry :x "50px" :anchor "right center")
  :stacking "bg"

  (box :orientation "v" :space-evenly false :style "padding: 10px; background: #282828"
       (image :path "${info.cover}" :image-width 300)
       (label :text "${info.name}")
       (label :text "${info.position}")
       (overlay
        (progress :class "bar" :value perc :style "padding: 5px")
        "${time} - ${perc}%")))
