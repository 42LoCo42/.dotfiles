{
	admin off

	tailscale {
		control_url {$HEADSCALE}
		state_dir /data/tailscale
	}

	pki {
		ca local {
			root {
				cert /ca.crt
				key /ca.key
			}
		}
	}

	local_certs
	skip_install_trust
}

(bind) {
	bind tailscale/bunny
}

(connect) {
	reverse_proxy localhost:12345 {
		header_up +to {args[0]}
	}
}

################################################################################

drasl.bunny {
	import bind
	reverse_proxy drasl:8080
}

################################################################################

