doctype html
html(lang = "en")
  head
    meta(charset = "utf-8")
    meta(name = "viewport", content = "width=device-width,initial-scale=1")

    title Nori's Homepage

    meta(property = "og:title"       content = "Nori's Homepage")
    meta(property = "og:site_name"   content = "Nori's Homepage")
    meta(property = "og:url"         content = "https://eleonora.gay")
    meta(property = "og:description" content = "Welcome to the silly realm :3")
    meta(property = "og:type"        content = "website")
    meta(property = "og:image"       content = "https://eleonora.gay/profile.webp")

    link(href = "/style.css" rel = "stylesheet")

  body
    div(id = "terminal" style = "display: none")
      mixin prompt(dir, cmd)
        x-prompt
          span eleonora@bunny
          | :
          span #{dir}
          | $&nbsp;
          x-typw(pause = "750" delay = "50") #{cmd}
          block
          x-typw(delay = "5")

      mixin neofetch(key, val = "")
        x-neofetch #{key}
        = ": " + val
        block
        br

      mixin neosub(key, val = "")
        x-neosub #{key}
        = ": " + val
        block
        br

      div(id = "term-main" class = "mobile-vbox")
        block content

      div(id = "term-foot")
        x-typw(hidec = "")
        h6(style = "text-align: center; color: gray")
          | This is @hash@
          br
          a(href = "https://nixwebr.ing/prev/nori") ←
          a(href = "https://nixwebr.ing") nixwebr.ing
          a(href = "https://nixwebr.ing/rand") (random)
          a(href = "https://nixwebr.ing/next/nori") →


    script(src = "/age.js")
    script(src = "/oneko.js")
    script(src = "/typewriter.js")
