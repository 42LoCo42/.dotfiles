// -*- mode: jsonc; -*-
{
	"grants": [
		{
			"src": ["*"],
			"dst": ["*"],
			"ip": ["*"]
		}
	],

	"ssh": [
		{
			"action": "accept",
			"src": ["autogroup:member"],
			"dst": ["tag:nix-builder"],
			"users": ["runner"]
		}
	],

	"groups": {
		"group:admin": ["leonsch@protonmail.com"]
	},

	"tagOwners": {
		"tag:exit": ["group:admin"],
		"tag:nix-builder": ["group:admin"]
	},

	"autoApprovers": {
		"exitNode": ["tag:exit"]
	}
}
