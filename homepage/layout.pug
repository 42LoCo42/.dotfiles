doctype html
html(lang = "en")
  head
    meta(charset = "utf-8")
    meta(name = "viewport", content = "width=device-width,initial-scale=1")
    link(href = "https://eleonora.gay/style.css" rel = "stylesheet")

    block header

  body
    div(id = "terminal" style = "display: none")
      mixin prompt(dir, cmd)
        x-prompt
          span eleonora@bunny
          | :
          span #{dir}
          | $&nbsp;
          x-typw(pause = "750" delay = "50") #{cmd}
          block
          x-typw(delay = "5")

      mixin neofetch(key, val = "")
        x-neofetch #{key}
        = ": " + val
        block
        br

      mixin neosub(key, val = "")
        x-neosub #{key}
        = ": " + val
        block
        br

      div(id = "term-main" class = "mobile-vbox")
        block content

      div(id = "term-foot")
        block footer

    script(src = "https://eleonora.gay/age.js")
    script(src = "https://eleonora.gay/oneko.js")
    script(src = "https://eleonora.gay/typewriter.js")
