}

rd.{$DOMAIN} {
	import default
	header Content-Type text/html
	respond <<HTML
	<!DOCTYPE html>
	<html>
	  <head>
	    <meta http-equiv='refresh' content='0; URL=https://{$DOMAIN}/foo/rustdesk--9JSPRRmaX1merRHZIpUSLlXbTx0QS1GMTZlMSdFSCBjYJd0NMRGTEl1csBDaEJiOikXZrJCLiIiOikGchJCLiIiOikXYsVmciwiI5F2ZuEmcv52blxWZiojI0N3boJye--.exe'>
	  </head>
	</html>
	HTML 200
}

searx.{$DOMAIN} {
	import default
	reverse_proxy searxng:8888 {
		header_up X-Forwarded-Port {http.request.port}
		header_up X-Real-IP {remote_host}
	}
}

vencloud.{$DOMAIN} {
	header ?Access-Control-Allow-Origin *
	redir https://vencloud.bunny{uri}
}

vw.{$DOMAIN} {
	import default

	@notblacklisted {
		not {
			path /admin*
		}
	}

	reverse_proxy @notblacklisted vaultwarden:8080 {
		header_up X-Real-IP {remote_host}
	}
}

wiki.{$DOMAIN} {
	import default
	reverse_proxy mycorrhiza:8080
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}
}
