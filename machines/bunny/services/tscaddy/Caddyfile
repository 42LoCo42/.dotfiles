{
	admin off

	tailscale {
		control_url https://headscale.eleonora.gay
		ephemeral true
	}

	pki {
		ca local {
			root {
				cert /ca.crt
				key /ca.key
			}
		}
	}

	local_certs
	skip_install_trust
}

(bind) {
	bind tailscale/bunny
}

(connect) {
	reverse_proxy localhost:12345 {
		header_up +to {args[0]}
	}
}

git.bunny:22 {
	import bind
	import connect forgejo:2222
}

git.bunny {
	import bind
	reverse_proxy forgejo:8080
}

img.bunny {
	import bind
	reverse_proxy immich:8080
}

pin.bunny {
	import bind
	reverse_proxy pinlist:8080
}

rd.bunny {
	import bind
	reverse_proxy rustdesk:21114
}

ssh.bunny {
	import bind
	import connect host.containers.internal:18213
}

sync.bunny {
	import bind
	reverse_proxy syncthing:8080
}

vencloud.bunny {
	import bind
	header ?Access-Control-Allow-Origin *
	reverse_proxy vencloud:8080
}

vw.bunny {
	import bind

	reverse_proxy vaultwarden:8080 {
		header_up X-Real-IP {remote_host}
	}
}
